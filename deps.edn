  org.clj-commons/hickory            {:mvn/version "0.7.7"}
  org.clojure/core.memoize           {:mvn/version "1.2.281"}
  markdown-clj/markdown-clj          {:mvn/version "1.12.8"}}
 :aliases
 {:dev    {:extra-paths ["dev"]
           :extra-deps  {integrant/repl {:mvn/version "0.5.1"}}}
  :server {:main-opts ["-m" "evolduo-app.system"]}
  :build  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
           :ns-default build}
  :test   {:extra-paths ["test"]
           :extra-deps  {io.github.cognitect-labs/test-runner
                         {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
           :main-opts   ["-m" "cognitect.test-runner"]
           :exec-fn     cognitect.test-runner.api/test}}}
